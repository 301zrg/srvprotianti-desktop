{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "706 天梯助手",
  "version": "0.1.2",
  "identifier": "org.srvprotianti.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "706 天梯助手",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "url": "rooms.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
