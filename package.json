{
  "name": "srvprotianti-desktop",
  "private": true,
  "version": "0.2.2",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "prepare:pages": "node scripts/prepare-pages.mjs",
    "predev": "npm run prepare:pages && esbuild src/desktop-bridge.ts --bundle --preserve-symlinks --format=iife --platform=browser --target=es2022 --outfile=public/assets/desktop-bridge.js",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build:web": "npm run predev && vite build --outDir dist",
    "build": "tauri build --no-bundle",
    "build:installer": "tauri build",
    "package:portable": "node scripts/package-portable.mjs",
    "package:pages": "node scripts/page-package.mjs",
    "test:pages": "node --test scripts/page-package.test.mjs scripts/rebuild-page-package.test.mjs scripts/publish-page-package.test.mjs scripts/sync-web-source.test.mjs",
    "test:platform": "node scripts/platform-ui.test.mjs",
    "check": "tsc --noEmit && npm run build:web && node --test scripts/color.test.mjs scripts/rooms.test.mjs scripts/stats.test.mjs scripts/workbook.test.mjs scripts/page-package.test.mjs scripts/rebuild-page-package.test.mjs scripts/publish-page-package.test.mjs scripts/sync-web-source.test.mjs scripts/csp-consistency.test.mjs scripts/page-updates-ui.test.mjs scripts/desktop-release.test.mjs scripts/desktop-updates-ui.test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "esbuild": "^0.25.0",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
